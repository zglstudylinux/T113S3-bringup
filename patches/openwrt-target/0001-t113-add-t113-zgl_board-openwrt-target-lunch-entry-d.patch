+    return
+  fi
+  if [ $1 == "mtp" ]; then
+    set_usb_function mtp 0x045E 0x00C9
+    return
+  fi
+  if [ $1 == "rndis" ]; then
+    set_usb_function rndis 0x0525 0xa4a2
+    return
+  fi
+  if [ $1 == "uac1" ]; then
+    set_usb_function uac1 0x1d61 0x0101
+    return
+  fi
+  if [ $1 == "mass_storage" ]; then
