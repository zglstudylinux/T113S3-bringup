+    return
+  fi
+  if [ $1 == "adb,mtp" -o $1 == "mtp,adb" ]; then
+    set_usb_function mtp,adb 0x1f3a 0x1007
+    return
+  fi
+  if [ $1 == "adb,hid" -o $1 == "hid,adb" ]; then
+    set_usb_function adb,hid 0x18d1 0xD002
+    #set_usb_function adb,hid 0x16c0 0x047d
+    return
