From 14a281d6d7dcd4fd67934a14682b3a463e983797 Mon Sep 17 00:00:00 2001
From: zglstudylinux <zglstudylinux@users.noreply.github.com>
Date: Fri, 16 Oct 2026 11:02:59 +0800
Subject: [PATCH] t113: zgl_board enable dx_touch node (phase-3)

dxts@38 status disabled -> okay. Property names match the driver
(touch-gpio / reset-gpio, not interrupts / reset-gpios).

Verified on board (adb 2026-10-16): i2cdetect UU@0x38 on bus 1,
touch events on event4.
---
 configs/zgl_board/linux-5.4/board.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/configs/zgl_board/linux-5.4/board.dts b/configs/zgl_board/linux-5.4/board.dts
index 0798a57..81cc017 100644
--- a/configs/zgl_board/linux-5.4/board.dts
+++ b/configs/zgl_board/linux-5.4/board.dts
@@ -915,7 +915,7 @@
         max-y = <640>;
         touch-gpio = <&pio PE 5 GPIO_ACTIVE_HIGH>;
         reset-gpio = <&pio PE 4 GPIO_ACTIVE_HIGH>;
-        status = "disabled";   /* phase-3 (touch) will enable */
+        status = "okay";
     };
 };
 
