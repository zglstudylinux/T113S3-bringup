+	dxts@38 {
+		compatible    = "dx,touch";
+		reg           = <0x38>;
+		max-x         = <480>;
+		max-y         = <640>;
+		tp-size       = <89>;
+		interrupt-parent = <&pio>;
+		/* PE5 = port 5 (PE), pin 5 (PE5), falling edge */
+		interrupts    = <5 5 IRQ_TYPE_EDGE_FALLING>;
+		/* PE4 = port 5 (PE), pin 4 (PE4), active low */
+		reset-gpios   = <&pio 5 4 GPIO_ACTIVE_LOW>;
