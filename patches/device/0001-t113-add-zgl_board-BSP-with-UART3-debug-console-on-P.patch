+    user_type    = 0x8000
+
+[partition]
+    name         = dsp0
+    size         = 2048
+    downloadfile = "amp_dsp0.fex"
+    user_type    = 0x8000
+
+[partition]
+    name         = private
+    size         = 2048
+    ;downloadfile = ""
+    user_type    = 0x8000
+
+[partition]
+    name         = UDISK
+    user_type    = 0x8100
+
